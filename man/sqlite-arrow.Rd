   \code{binary}, \code{large_binary}, \code{fixed_size_binary}, \code{binary_view} \tab blob \cr
   \code{date32}, \code{date64} \tab real: days since 1970-01-01 \cr
   \code{time32}, \code{time64}, \code{duration} \tab real: seconds \cr
   \code{timestamp} \tab real: seconds since 1970-01-01 UTC \cr
